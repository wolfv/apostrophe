<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <object class="AdwShortcutsDialog" id="shortcuts_dialog">
    <child>
      <object class="AdwShortcutsSection" id="s1lbl">
        <property name="title" translatable="yes" context="shortcuts dialog">General</property>
        <child>
          <object class="AdwShortcutsItem" id="s1-1">
            <property name="title" translatable="yes" context="shortcuts dialog">New</property>
            <property name="action-name">app.new-window</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem" id="s1-2">
            <property name="title" translatable="yes" context="shortcuts dialog">Open</property>
            <property name="action-name">win.open</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem" id="s1-3">
            <property name="title" translatable="yes" context="shortcuts dialog">Save</property>
            <property name="action-name">win.save</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem" id="s1-4">
            <property name="title" translatable="yes" context="shortcuts dialog">Save As</property>
            <property name="action-name">win.save_as</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem" id="s1-5">
            <property name="title" translatable="yes" context="shortcuts dialog">Close Document</property>
            <property name="action-name">win.close</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem" id="s1-5d">
            <property name="title" translatable="yes" context="shortcuts dialog">Show Preferences</property>
            <property name="action-name">app.preferences</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem" id="s1-5c">
            <property name="title" translatable="yes" context="shortcuts dialog">Keyboard Shortcuts</property>
            <property name="action-name">app.shortcuts</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem" id="s1-5b">
            <property name="title" translatable="yes" context="shortcuts dialog">Quit Application</property>
            <property name="action-name">app.quit</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwShortcutsSection" id="modes">
        <property name="title" translatable="yes" context="shortcuts dialog">Modes</property>
        <child>
          <object class="AdwShortcutsItem" id="s1-6">
            <property name="title" translatable="yes" context="shortcuts dialog">Focus Mode</property>
            <property name="action-name">win.focus_mode</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem" id="s1-7">
            <property name="title" translatable="yes" context="shortcuts dialog">Hemingway Mode</property>
            <property name="action-name">win.hemingway_mode</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem" id="s1-9">
            <property name="title" translatable="yes" context="shortcuts dialog">Preview</property>
            <property name="action-name">win.preview</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem" id="s1-8">
            <property name="title" translatable="yes" context="shortcuts dialog">Fullscreen</property>
            <property name="action-name">win.fullscreen</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwShortcutsSection" id="search">
        <property name="title" translatable="yes" context="shortcuts dialog">Find</property>
        <child>
          <object class="AdwShortcutsItem" id="s1-10">
            <property name="title" translatable="yes" context="shortcuts dialog">Find</property>
            <property name="action-name">win.find</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem" id="s1-11">
            <property name="title" translatable="yes" context="shortcuts dialog">Find and Replace</property>
            <property name="action-name">win.find_replace</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwShortcutsSection" id="markdown">
        <property name="title" translatable="yes" context="shortcuts dialog">Markdown</property>
        <child>
          <object class="AdwShortcutsItem" id="s2-1">
            <property name="title" translatable="yes" context="shortcuts dialog">Separator</property>
            <property name="accelerator">&lt;Primary&gt;r</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem" id="s2-2">
            <property name="title" translatable="yes" context="shortcuts dialog">Header</property>
            <property name="accelerator">&lt;Primary&gt;1 4</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem" id="s2-3">
            <property name="title" translatable="yes" context="shortcuts dialog">List Item</property>
            <property name="accelerator">&lt;Primary&gt;u</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem" id="s2-4">
            <property name="title" translatable="yes" context="shortcuts dialog">Italic</property>
            <property name="accelerator">&lt;Primary&gt;i</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem" id="s2-5">
            <property name="title" translatable="yes" context="shortcuts dialog">Bold</property>
            <property name="accelerator">&lt;Primary&gt;b</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem" id="s2-6">
            <property name="title" translatable="yes" context="shortcuts dialog">Strikeout</property>
            <property name="accelerator">&lt;Shift&gt;&lt;Primary&gt;D</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwShortcutsSection" id="copy-paste">
        <property name="title" translatable="yes" context="shortcuts dialog">Copy and Paste</property>
        <child>
          <object class="AdwShortcutsItem" id="s3-1">
            <property name="title" translatable="yes" context="shortcuts dialog">Copy</property>
            <property name="accelerator">&lt;Primary&gt;C</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem" id="s3-2">
            <property name="title" translatable="yes" context="shortcuts dialog">Cut</property>
            <property name="accelerator">&lt;Primary&gt;X</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem" id="s3-3">
            <property name="title" translatable="yes" context="shortcuts dialog">Paste</property>
            <property name="accelerator">&lt;Primary&gt;V</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwShortcutsSection" id="undo-redo">
        <property name="title" translatable="yes" context="shortcuts dialog">Undo and Redo</property>
        <child>
          <object class="AdwShortcutsItem" id="s4-1">
            <property name="title" translatable="yes" context="shortcuts dialog">Undo Previous Command</property>
            <property name="accelerator">&lt;Primary&gt;Z</property>
          </object>
        </child>
        <child>
          <object class="AdwShortcutsItem" id="s4-2">
            <property name="title" translatable="yes" context="shortcuts dialog">Redo Previous Command</property>
            <property name="accelerator">&lt;Shift&gt;&lt;Primary&gt;Z</property>
          </object>
        </child>
      </object>
    </child>
    <child>
      <object class="AdwShortcutsSection" id="selection">
        <property name="title" translatable="yes" context="shortcuts dialog">Selection</property>
        <child>
          <object class="AdwShortcutsItem" id="s5-1">
            <property name="title" translatable="yes" context="shortcuts dialog">Select All Text</property>
            <property name="accelerator">&lt;Primary&gt;A</property>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
